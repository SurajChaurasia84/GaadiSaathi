{
  "version": 2,
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/public/.well-known/assetlinks.json"
    },
    {
      "source": "/profile",
      "destination": "/public/profile/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  }
}
