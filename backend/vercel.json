{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "public/.well-known/assetlinks.json"
    },
    {
      "src": "/profile",
      "dest": "public/profile/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/$1.js"
    }
  ]
}
